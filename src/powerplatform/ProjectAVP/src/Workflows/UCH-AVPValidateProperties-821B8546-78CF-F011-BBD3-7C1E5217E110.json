        "CoStar_Run": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@triggerBody()?['boolean']",
                  "@true"
                ]
              }
            ]
          },
          "actions": {
            "Process_CoStar": {
              "type": "Scope",
              "actions": {
                "Convert_time_zone": {
                  "type": "Expression",
                  "kind": "ConvertTimeZone",
                  "inputs": {
                    "baseTime": "@utcNow()",
                    "sourceTimeZone": "UTC",
                    "destinationTimeZone": "Pacific Standard Time",
                    "formatString": "HH"
                  }
                },
                "CoStar_Run_Flag": {
                  "type": "Compose",
                  "inputs": "@or(\r\n  equals(int(body('Convert_time_zone')), 7),\r\n  equals(int(body('Convert_time_zone')), 10),\r\n  equals(int(body('Convert_time_zone')), 12),\r\n  equals(int(body('Convert_time_zone')), 14),\r\n  equals(int(body('Convert_time_zone')), 17)\r\n)",
                  "runAfter": {
                    "Convert_time_zone": [
                      "Succeeded"
                    ]
                  }
                },
                "Scheduled_Run": {
                  "type": "If",
                  "expression": {
                    "or": [
                      {
                        "equals": [
                          "@triggerBody()?['boolean']",
                          "@true"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Fetch_Costar_Queue": {
                      "type": "Http",
                      "inputs": {
                        "uri": "@body('Get_Callback_URL_for_Fetch_Work_Queue')?['callback_url']",
                        "method": "POST",
                        "body": {
                          "Status": "@{triggerBody()?['text']}"
                        }
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      },
                      "metadata": {
                        "operationMetadataId": "109f479f-fb8c-4c39-9a1f-5792ade7c33c"
                      }
                    },
                    "CoStar_Queue": {
                      "type": "Query",
                      "inputs": {
                        "from": "@body('Fetch_Costar_Queue')",
                        "where": "@equals(item()?['Valuation Source'],'CoStar')"
                      },
                      "runAfter": {
                        "Fetch_Costar_Queue": [
                          "Succeeded"
                        ]
                      }
                    },
                    "CoStar_Items": {
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@empty(body('CoStar_Queue'))",
                              "@false"
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Run_Desktop_Flow": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "uiFlowId": "2e6975e7-8c20-4f15-9fec-ac412e9a55dd",
                              "runMode": "@parameters('UCH-AVP Run Mode (clr_UCHAVPRunMode)')",
                              "item/aryWorkQueue": "@body('CoStar_Queue')",
                              "item/strCoStarUser_Name": "@parameters('UCH-AVP CoStar Username (clr_UCHAVPCoStarUsername)')",
                              "item/strCoStarUser_Password": "@outputs('Get_CoStar_Secret')?['body/value']",
                              "item/strNotifyEmail_Business": "@parameters('UCH-AVP Notification (TO | Business) (clr_UCHAVPNotificationBusiness)')",
                              "item/strNotifyEmail_Support": "@parameters('UCH-AVP Notification (TO | Support | AVP) (clr_UCHAVPNotificationSupport)')",
                              "item/strNotifyLabel": "@parameters('UCH-AVP Notification (Label) (clr_UCHAVPNotificationLabel)')",
                              "item/strWebApp_CoStar_BaseUrl": "@parameters('UCH-AVP CoStar Portal URL (clr_UCHAVPCoStarPortalURL)')",
                              "item/strWebApp_FetchQueue_URL": "@body('Get_Callback_URL_for_Fetch_Work_Queue')?['callback_url']",
                              "item/strWebApp_FlowMailer_URL": "@body('Get_Callback_URL_for_Send_Notification')?['callback_url']",
                              "item/strWebApp_UpdateQueueUrl": "@body('Get_Callback_URL_for_Update_Work_Queue')?['callback_url']",
                              "item/tblExceptions_Tracker": "@outputs('Workflow_Outline')",
                              "item/strWebApp_FileUpload_URL": "@body('Get_Callback_URL_for_Upload_File')?['callback_url']",
                              "item/strValuationSource": "CoStar",
                              "item/strWebApp_OpenAIRequest_URL": "@body('Get_Callback_URL_for_OpenAI_Request')?['callback_url']",
                              "item/strWebApp_FetchMFA_URL": "@body('Get_Callback_URL_for_CoStar_MFA_Code')?['callback_url']",
                              "item/strWebApp_Zillow_BaseUrl": "@parameters('UCH-AVP Zillow Search URL (clr_UCHAVPZillowSearchURL)')",
                              "item/strWebApp_FetchLlmPrompt_URL": "@body('Get_Callback_URL_for_Fetch_LLM_Prompt')?['callback_url']",
                              "item/strWebApp_Redfin_BaseUrl": "https://www.redfin.com/",
                              "item/strWebApp_ImageAnalysis_URL": "@body('Get_Callback_URL_for_Image_Analysis')?['callback_url']",
                              "item/strWebApp_Realtor_BaseUrl": "https://www.realtor.com/"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_uiflow",
                              "operationId": "RunUIFlow_V2",
                              "connectionName": "shared_uiflow"
                            }
                          }
                        },
                        "Send_CoStar_failure_email_notification": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "parameters": {
                              "emailMessage/MailboxAddress": "@parameters('UCH-AVP Notification (From) (clr_UCHAVPNotificationFrom)')",
                              "emailMessage/To": "@parameters('UCH-AVP Notification (TO | Support | AVP) (clr_UCHAVPNotificationSupport)')",
                              "emailMessage/Subject": "UCH-AVP Failure@{parameters('UCH-AVP Notification (Label) (clr_UCHAVPNotificationLabel)')}: RPA Run Failure (CoStar)",
                              "emailMessage/Body": "<p class=\"editor-paragraph\">The RPA encountered an error; see issue below:</p><p class=\"editor-paragraph\">@{body('Run_Desktop_Flow')?['error']?['message']}</p>",
                              "emailMessage/Importance": "Normal"
                            },
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                              "operationId": "SharedMailboxSendEmailV2",
                              "connectionName": "shared_office365"
                            }
                          },
                          "runAfter": {
                            "Run_Desktop_Flow": [
                              "Failed"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {
                        "CoStar_Queue": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "CoStar_Run_Flag": [
                      "Succeeded"
                    ]
                  }
                }
