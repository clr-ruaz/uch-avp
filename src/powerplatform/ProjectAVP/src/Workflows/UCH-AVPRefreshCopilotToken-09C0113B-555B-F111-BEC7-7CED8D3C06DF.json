          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "UCH-AVP M365 Copilot API (Client ID) (clr_UCHAVPM365CopilotAPIClientID)": {
          "defaultValue": "c80953eb-27d8-4ca2-b329-3461398d519a",
