          "defaultValue": "M365-COPILOT-Refresh-PRD",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UCHAVPM365CopilotAPIRefreshToken"
          }
        },
        "UCH-AVP M365 Copilot API (Client Secret) (clr_UCHAVPM365CopilotAPIClientSecret)": {
          "defaultValue": "M365-COPILOT-Client-PRD",
