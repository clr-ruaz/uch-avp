              "Property Type": "@outputs('Set_Valuation_Status')?['body/PropertyType']",
              "Valuation Status": "@outputs('Set_Valuation_Status')?['body/ValuationStatus/Value']"
            }
          },
          "runAfter": {
            "Set_Valuation_Status": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "c86100f2-b364-4b05-85d8-663c9b6a6192"
          }
        },
        "Valuation_Source": {
          "type": "Compose",
          "inputs": "@if(\r\n  contains(\r\n    parameters('UCH-AVP Parameter (Valid CoStar Codes) (clr_UCHAVPParameterValidPropertyCodes)'),\r\n    outputs('Get_SharePoint_Item')?['body/PropertyType']\r\n  ),\r\n  'CoStar',\r\n  if(\r\n    contains(\r\n      parameters('UCH-AVP Parameter (Valid Zillow Codes) (clr_UCHAVPParameterValidZillowCodes)'),\r\n      outputs('Get_SharePoint_Item')?['body/PropertyType']\r\n    ),\r\n    'Zillow',\r\n    null\r\n  )\r\n)",
          "runAfter": {
            "Get_SharePoint_Item": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5427384d-28ef-47c0-aaa1-a18b2670a83f"
          }
        },
        "Get_SharePoint_Item": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('UCH-AVP SharePoint Site (clr_UCHAVPSharePointSite)')",
              "table": "@parameters('UCH-AVP SharePoint List (Property Listing) (clr_UCHAVPSharePointListPropertyRadar)')",
              "id": "@triggerBody()?['sharepoint_id']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetItem",
              "connectionName": "shared_sharepointonline"
            }
          },
          "runAfter": {}
        },
        "Set_Valuation_Status": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('UCH-AVP SharePoint Site (clr_UCHAVPSharePointSite)')",
              "table": "@parameters('UCH-AVP SharePoint List (Property Listing) (clr_UCHAVPSharePointListPropertyRadar)')",
              "id": "@outputs('Get_SharePoint_Item')?['body/ID']",
              "item/Title": "@outputs('Get_SharePoint_Item')?['body/Title']",
              "item/RadarID": "@outputs('Get_SharePoint_Item')?['body/RadarID']",
              "item/ValuationSource/Value": "@outputs('Valuation_Source')",
              "item/ValuationStatus/Value": "Pending"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "PatchItem",
              "connectionName": "shared_sharepointonline"
            }
          },
          "runAfter": {
            "Valuation_Source": [
              "Succeeded"
            ]
          }
        },
        "Fail_Response": {
          "type": "Response",
          "kind": "Http",
          "inputs": {
            "statusCode": "@body('Get_SharePoint_Item')?['status']",
            "body": {
              "Message": "@body('Get_SharePoint_Item')?['message']"
            }
          },
          "runAfter": {
            "Get_SharePoint_Item": [
              "FAILED"
            ]
          },
          "metadata": {
            "operationMetadataId": "c86100f2-b364-4b05-85d8-663c9b6a6192"
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
