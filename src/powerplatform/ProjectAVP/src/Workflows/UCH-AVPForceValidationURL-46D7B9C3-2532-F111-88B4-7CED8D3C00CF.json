        }
      },
      "actions": {
        "Success_Response": {
          "type": "Response",
          "kind": "Http",
          "inputs": {
            "statusCode": 200,
            "body": {
              "Address": "@outputs('Set_Valuation_Status')?['body/Address']",
              "City": "@outputs('Set_Valuation_Status')?['body/City']",
              "State": "@outputs('Set_Valuation_Status')?['body/State']",
              "Zip": "@outputs('Set_Valuation_Status')?['body/Zip']",
