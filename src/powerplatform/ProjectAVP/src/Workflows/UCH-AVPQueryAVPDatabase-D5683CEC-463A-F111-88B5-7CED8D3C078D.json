        },
        "Matches_Found": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@empty(body('Match_Properties')?['value'])",
                  false
                ]
              }
            ]
          },
          "actions": {
            "Properties_Table": {
              "type": "Table",
              "inputs": {
                "from": "@body('Matched_Properties')",
                "format": "HTML"
              }
            },
            "Set_Matched_Flag": {
              "type": "SetVariable",
              "inputs": {
                "name": "blnMatched",
                "value": true
              },
              "runAfter": {
                "Properties_Summary": [
                  "Succeeded"
                ]
              }
            },
            "Properties_Summary": {
              "type": "Compose",
              "inputs": {
                "Properties Data": "@body('Matched_Properties')",
                "Additional Notes": "@if(\r\n  greaterOrEquals(\r\n    length(body('Match_Properties')?['value']),\r\n    50\r\n  ),\r\n  concat(\r\n    'Note that there are more than ',\r\n    length(body('Match_Properties')?['value']), \r\n    ' records that matched your query in the AVP database but I can only process a maximum of 50 records at a time to answer your question. I recommend refining your search parameters.'\r\n  ),\r\n  null\r\n)"
              },
              "runAfter": {
                "Properties_Table": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Query_AVP_Data": [
              "Succeeded"
            ]
          }
        },
        "Get_Address_Fltr": {
          "type": "Scope",
          "actions": {
            "Address_Filter_ary": {
              "type": "Query",
              "inputs": {
                "from": [
                  {
                    "Label": "Address",
                    "Value": "@triggerBody()?['text_1']"
                  },
                  {
                    "Label": "City",
                    "Value": "@triggerBody()?['text_2']"
                  },
                  {
                    "Label": "State",
                    "Value": "@triggerBody()?['text_4']"
                  },
                  {
                    "Label": "Zip",
                    "Value": "@if(\r\n  or(\r\n    empty(string(triggerBody()?['text_5'])),\r\n    equals(\r\n      string(triggerBody()?['text_5']),\r\n      'null'\r\n    )\r\n  ),\r\n  null,\r\n  int(triggerBody()?['text_5'])\r\n)"
                  }
                ],
                "where": "@not(equals(or(\n  empty(string(item()?['Value'])),\n  equals(string(item()?['Value']), 'null')\n),true))"
              }
            },
            "Address_Filter_str": {
              "type": "Select",
              "inputs": {
                "from": "@body('Address_Filter_ary')",
                "select": "@if(\r\n  equals(\r\n    item()?['Label'],\r\n    'Zip'\r\n  ),\r\n  concat(\r\n    item()?['Label'],\r\n    ' eq ',\r\n    item()?['Value']\r\n  ),\r\n  concat(\r\n    'substringof(',\r\n    '''',\r\n    item()?['Value'],\r\n    ''', ',\r\n    item()?['Label'],\r\n    ')'\r\n  )\r\n)"
              },
              "runAfter": {
                "Address_Filter_ary": [
                  "Succeeded"
                ]
              }
            },
            "Address_Filter": {
              "type": "Compose",
              "inputs": "@concat(\n  if(\n    empty(body('Address_Filter_str')),\n    '',\n    '('\n  ),\n  join(\n    body('Address_Filter_str'),\n    ' and '\n  ),\n  if(\n    empty(body('Address_Filter_str')),\n    '',\n    ')'\n  )\n)",
              "runAfter": {
                "Address_Filter_str": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Init_Matched_bln": [
              "Succeeded"
            ]
          }
        },
        "Query_AVP_Data": {
          "type": "Scope",
          "actions": {
            "oData_Filter_ary": {
              "type": "Query",
              "inputs": {
                "from": [
                  "@if(\r\n  or(\r\n    equals(string(triggerBody()?['text']), 'null'),\r\n    empty(string(triggerBody()?['text']))\r\n  ),\r\n  null,\r\n  concat(\r\n    'Title eq ''',\r\n    triggerBody()?['text'],\r\n    ''''\r\n  )\r\n)",
                  "@if(\r\n  or(\r\n    equals(string(triggerBody()?['text_6']), 'null'),\r\n    empty(string(triggerBody()?['text_6']))\r\n  ),\r\n  null,\r\n  concat(\r\n    'APN eq ''',\r\n    triggerBody()?['text_6'],\r\n    ''''\r\n  )\r\n)",
                  "@if(\r\n  or(\r\n    equals(string(triggerBody()?['text_7']), 'null'),\r\n    empty(string(triggerBody()?['text_7']))\r\n  ),\r\n  null,\r\n  concat(\r\n    'RadarID eq ''',\r\n    triggerBody()?['text_7'],\r\n    ''''\r\n  )\r\n)",
                  "@outputs('Address_Filter')"
                ],
                "where": "@equals(empty(item()),false)"
              }
            },
            "oData_Filter": {
              "type": "Compose",
              "inputs": "@join(\r\n  body('oData_Filter_ary'),\r\n  ' or '\r\n)",
              "runAfter": {
                "oData_Filter_ary": [
                  "Succeeded"
                ]
              }
            },
